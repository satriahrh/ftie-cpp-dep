# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Others    
test/*
experiment/dum/*
experiment/results/*

# Results committed normally: experiment f's CSV and run record, its stderr
# log and archive hashes, and the shared environment record. (The a-e
# results under experiment/results/ are already tracked, so they need no
# exception; experiment/bbs_params.csv, the BBS keys of every run, is
# committed too.) <letter>.csv.partial and f.csv.keystream stay ignored.
!experiment/results/f.csv
!experiment/results/f.csv.params
!experiment/results/f.stderr.log
!experiment/results/f.archives.sha256
!experiment/results/env.txt

bin/*